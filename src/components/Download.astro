---
import Icon from './Icon.astro';
import { site } from '../site';

const platforms = [
  { name: 'Android 7.0 and up', status: 'Available now', note: 'Free on APKPure', ok: true },
  { name: 'iPhone', status: 'Coming later', note: 'On the way', ok: false },
  { name: 'Web', status: 'Coming later', note: 'On the way', ok: false },
  { name: 'Desktop', status: 'Coming later', note: 'On the way', ok: false },
];
---

<section class="section section--alt" id="download">
  <div class="wrap">
    <div class="section-head section-head--center">
      <p class="eyebrow">Get the app</p>
      <h2 class="h2">Up and running in a minute.</h2>
      <p class="lead">
        Get Serafim from APKPure. When a new version comes out, the app lets
        you know and can back up your chats before it updates.
      </p>
    </div>

    <div class="steps">
      <div class="step reveal">
        <div>
          <h3>Get it from APKPure</h3>
          <p>
            Tap the button below to open Serafim on APKPure, and download the
            latest version.
          </p>
        </div>
      </div>

      <div class="step reveal">
        <div>
          <h3>Install it</h3>
          <p>
            Open the download. If your phone asks whether it may install
            apps from there, say yes.
          </p>
        </div>
      </div>

      <div class="step reveal">
        <div>
          <h3>Sign in and make it yours</h3>
          <p>
            Continue with Google, choose a display name and a username, then
            pick a few interests. Serafim uses them to sort Discover before
            you send your first message.
          </p>
        </div>
      </div>
    </div>

    <div class="download__cta reveal">
      <a class="btn btn--primary btn--lg" href={site.apkpure} target="_blank" rel="noopener">
        <Icon name="download" size={18} />
        Get it on APKPure
      </a>
      <p class="btn-note">Version {site.version} · Free · No ads</p>
    </div>

    <div class="platforms reveal">
      <p class="platforms__label">Where Serafim runs</p>
      <ul class="platforms__list">
        {
          platforms.map((p) => (
            <li class="platform">
              <span class="platform__name">{p.name}</span>
              <span class="platform__status">
                {p.ok ? <span class="chip chip--teal">{p.status}</span> : <span class="chip">{p.status}</span>}
              </span>
              <span class="platform__note">{p.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .steps {
    max-width: 760px;
    margin-inline: auto;
  }

  .download__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .download__cta .btn-note {
    flex-basis: 100%;
    margin: 0;
    text-align: center;
  }

  .platforms {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .platforms__label {
    margin: 0 0 0.9rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary-pale);
  }

  .platforms__list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: var(--bw) solid var(--line);
    box-shadow: var(--shadow);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .platform {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    background: var(--paper-alt);
  }

  .platform__name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .platform__status .chip {
    align-self: flex-start;
  }

  .platform__note {
    font-size: 12px;
    color: var(--text-dim);
  }
</style>
