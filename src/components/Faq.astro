---
import { site } from '../site';

const faqs = [
  {
    q: 'What is Serafim?',
    a: 'A free chat and social app. Chat with friends one-to-one or in groups, share Moments and posts, and meet people through the interests you share.',
  },
  {
    q: 'How much does it cost?',
    a: 'Nothing. There is no subscription, no premium tier and no advertising.',
  },
  {
    q: 'Where do I download it?',
    a: 'On APKPure. Tap any "Get the app" button on this page, download Serafim, and open it to install. If your phone asks whether it may install apps from there, allow it.',
  },
  {
    q: 'Will it run on my phone?',
    a: 'Serafim runs on Android 7.0 and up, including many older and budget phones. An iPhone version is not available yet.',
  },
  {
    q: 'Will I lose my chats if I change phones?',
    a: 'No. Serafim backs up your chats to your own Google Drive and restores them when you sign in on a new phone.',
  },
  {
    q: 'Can I delete my account?',
    a: 'Yes, any time, from the privacy settings in the app.',
  },
];
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })}
/>

<section class="section" id="faq">
  <div class="wrap">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h2">Quick answers.</h2>
        <p class="lead">Still stuck? Send us a message.</p>
        <div class="btn-row">
          <a class="btn btn--ghost" href="mailto:hello@serafim.app">
            Ask a question
          </a>
        </div>
      </div>

      <div class="faq reveal">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* the accordion is much taller than the intro, so top-align them */
  .split {
    align-items: start;
  }
</style>
