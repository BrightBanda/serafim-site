---
import Icon from './Icon.astro';
---

<section class="section" id="privacy">
  <div class="wrap">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Privacy</p>
        <h2 class="h2">Your conversations stay close to home.</h2>
        <p class="lead">
          Most messengers upload your photos and voice notes to a server so
          everyone in the thread can fetch them. Serafim doesn't. When you send
          a picture, it is resized on your phone and then delivered to the
          people in the conversation — and nowhere else.
        </p>

        <ul class="list-check">
          <li>
            <strong>Photos and voice notes never touch our storage.</strong> They
            live on the phones of the people in the conversation.
          </li>
          <li>
            <strong>Your password never reaches our servers.</strong> Sign-in is
            handled by a third-party identity service; we only ever see a
            session token.
          </li>
          <li>
            <strong>No ad SDK, no analytics SDK, no data sold.</strong> The
            app ships with none of them.
          </li>
          <li>
            <strong>Your profile is yours to lock.</strong> Hide your friends,
            followers and following from anyone who is not a friend.
          </li>
        </ul>

        <div class="btn-row">
          <a class="btn btn--ghost" href="/privacy">Read the privacy policy</a>
        </div>
      </div>

      <div class="reveal">
        <div class="panel panel--settings">
          <p class="panel__label">Privacy settings</p>

          <div class="setting">
            <span class="setting__icon"><Icon name="eye" size={16} /></span>
            <span class="setting__body">
              <span class="setting__name">Read receipts</span>
              <span class="setting__desc">Let people see when you read a message</span>
            </span>
            <span class="toggle is-on"><span></span></span>
          </div>

          <div class="setting">
            <span class="setting__icon"><Icon name="lock" size={16} /></span>
            <span class="setting__body">
              <span class="setting__name">Lock profile</span>
              <span class="setting__desc">Hide friends and followers from non-friends</span>
            </span>
            <span class="toggle"><span></span></span>
          </div>

          <div class="setting">
            <span class="setting__icon"><Icon name="group" size={16} /></span>
            <span class="setting__body">
              <span class="setting__name">Add me to groups</span>
              <span class="setting__desc">Only friends</span>
            </span>
            <span class="select">Friends</span>
          </div>

          <div class="setting">
            <span class="setting__icon"><Icon name="download" size={16} /></span>
            <span class="setting__body">
              <span class="setting__name">Keep messages for</span>
              <span class="setting__desc">How long conversations stay on this phone</span>
            </span>
            <span class="select">30 days</span>
          </div>

          <div class="setting">
            <span class="setting__icon"><Icon name="user-plus" size={16} /></span>
            <span class="setting__body">
              <span class="setting__name">Friend requests</span>
              <span class="setting__desc">Let strangers send you a request</span>
            </span>
            <span class="toggle is-on"><span></span></span>
          </div>
        </div>

        <p class="panel__note mono">
          Screenshots taken from the app's own privacy screen
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .panel--settings {
    padding: 1.25rem;
  }

  .panel__label {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary-pale);
  }

  .panel__note {
    margin: 1rem 0 0;
    text-align: center;
  }

  .setting {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.5rem;
  }

  .setting + .setting {
    border-top: 1px solid var(--line-soft);
  }

  .setting__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    color: var(--primary-pale);
  }

  .setting__body {
    flex: 1;
    min-width: 0;
  }

  .setting__name {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .setting__desc {
    display: block;
    font-size: 11.5px;
    color: var(--text-dim);
  }

  .toggle {
    flex: none;
    display: flex;
    align-items: center;
    width: 40px;
    height: 20px;
    padding: 2px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .toggle span {
    width: 14px;
    height: 14px;
    background: var(--text-dim);
    transition: transform 0.16s ease, background 0.16s ease;
  }

  .toggle.is-on {
    background: color-mix(in srgb, var(--primary) 30%, transparent);
    border-color: var(--primary);
  }

  .toggle.is-on span {
    background: var(--primary-pale);
    transform: translateX(18px);
  }

  .select {
    flex: none;
    padding: 0.3rem 0.55rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text);
  }
</style>
