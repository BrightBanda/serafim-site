---
import Icon from './Icon.astro';

const features = [
  { icon: 'chat', title: 'Chats and groups', body: 'Message friends one-to-one or in groups, with reactions, replies and read receipts.' },
  { icon: 'image', title: 'Moments', body: 'Share a photo or short video that disappears after 24 hours.' },
  { icon: 'signal', title: 'Echos', body: 'Send a quick "anyone up for a chat?" to people who share your interests.' },
  { icon: 'mic', title: 'Voice, stickers and GIFs', body: 'Voice notes, videos, stickers and GIFs, right in the chat.' },
  { icon: 'search', title: 'Discover', body: 'Meet new people through the interests you share.' },
  { icon: 'shield', title: 'Private and free', body: 'No ads, no subscription. Chats back up to your own Google Drive.' },
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head section-head--center">
      <p class="eyebrow">What's inside</p>
      <h2 class="h2">Chat, share and meet people.</h2>
    </div>

    <div class="grid grid--3">
      {
        features.map((f) => (
          <article class="card reveal">
            <div class="card__icon">
              <Icon name={f.icon} />
            </div>
            <h3 class="h4">{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
