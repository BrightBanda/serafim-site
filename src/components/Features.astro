---
import Icon from './Icon.astro';
import { site } from '../site';

const highlights = [
  {
    icon: 'signal',
    title: 'Echos',
    body: "Up for a chat? Send an Echo with a short message and it reaches up to 30 people who share your interests — friends, new people, or both. They get a notification, and one tap starts the chat. Echos last 30 minutes, and you can switch them off.",
  },
  {
    icon: 'sticker',
    title: 'Draw Together',
    body: 'Open a shared canvas with a friend and doodle at the same time. Every stroke shows up on both phones as you draw.',
  },
  {
    icon: 'heart',
    title: 'Reactions and nicknames',
    body: 'Hold a message to react with a thumbs up, a laugh, a celebration, anger, wow or cooked. Give friends nicknames, and see what they call you.',
  },
];

const features = [
  {
    icon: 'star',
    title: 'Feed and posts',
    body: 'Share posts with a title, photos and words. Your feed shows what you will like most first, with a Latest tab when you just want what is new. Edit a post any time.',
  },
  {
    icon: 'group',
    title: 'Circles',
    body: 'Communities around the things you love. Invite friends, add members, and keep things tidy with the circle settings.',
  },
  {
    icon: 'chat',
    title: 'Chats and groups',
    body: 'See when a message is sent, delivered and read. Reply, edit, delete for everyone, and run groups with owners, admins and house rules.',
  },
  {
    icon: 'mic',
    title: 'Voice, video and music',
    body: 'Hold to record a voice note, slide up to keep recording hands-free. Send videos and audio files, and play them right in the chat.',
  },
  {
    icon: 'gift',
    title: 'Stickers and GIFs',
    body: 'A hand-drawn Doodle Gang pack, GIFs from your keyboard, and your own sticker collections to keep the good ones close.',
  },
  {
    icon: 'search',
    title: 'Discover',
    body: 'Meet people through the interests you share, and find friends by their username.',
  },
  {
    icon: 'bell',
    title: 'Notifications you can answer',
    body: 'Reply straight from the notification without opening the app. Every message stays in the list, and calm in-app sounds let you know without making you jump. Pick your own sounds, too.',
  },
  {
    icon: 'image',
    title: 'Make it yours',
    body: 'Chat backgrounds from doodles, colours, gradients or your own photo. Light and dark themes, four text sizes, and a profile picture you can crop just right.',
  },
  {
    icon: 'shield',
    title: 'Backed up, always',
    body: 'Your chats back up to your own Google Drive automatically, and come back when you change phones.',
  },
];

const also = [
  'Halo: show you are free to chat',
  'Wings: your close friends',
  'Sparks and comments',
  'Share posts into chats',
  'Report posts and messages',
  'Swipe to reply',
  'Link previews',
  'Save images to gallery',
  'Lock your profile',
  'Official SERAFIM chat',
  'Back up before you update',
  'Delete your account any time',
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head section-head--center">
      <p class="eyebrow">What's inside</p>
      <h2 class="h2">Your friends, your circles,<br />and people you have yet to meet.</h2>
      <p class="lead">
        Chat with the people you know, share with the communities you belong
        to, and find new people who love what you love — all in one free app,
        with no ads.
      </p>
    </div>

    <p class="new-label">New in {site.version}</p>
    <div class="grid grid--3 new-grid">
      {
        highlights.map((f) => (
          <article class="card card--new reveal">
            <div class="card__icon">
              <Icon name={f.icon} />
            </div>
            <h3 class="h4">{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>

    <div class="grid grid--3">
      {
        features.map((f) => (
          <article class="card reveal">
            <div class="card__icon">
              <Icon name={f.icon} />
            </div>
            <h3 class="h4">{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>

    <div class="also reveal">
      <h3 class="also__title">Also included</h3>
      <ul class="also__list">
        {also.map((item) => (
          <li>
            <Icon name="check" size={13} />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .new-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-pale);
  }

  .new-grid {
    margin-bottom: 1.5rem;
  }

  .card--new {
    border-color: var(--primary);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--primary) 16%, transparent),
        transparent 65%
      ),
      var(--paper-alt);
  }

  .also {
    margin-top: 2.5rem;
    padding: 1.75rem 1.5rem;
    background: var(--paper-alt);
    border: var(--bw) solid var(--line);
    box-shadow: var(--shadow);
  }

  .also__title {
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary-pale);
  }

  .also__list {
    display: grid;
    gap: 0.6rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .also__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .also__list svg {
    flex: none;
    color: var(--teal-pale);
  }
</style>
